{
  "name": "helm",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": { "node": ">=24.12.0" },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @helm/protocol --filter @helm/node run build && tsc --noEmit -p tsconfig.check.json",
    "test": "timeout 180s tsx --test \"packages/*/test/*.test.ts\" \"packages/*/test/*.test.tsx\"",
    "dev": "pnpm --filter @helm/protocol run build && pnpm --parallel --filter @helm/kernel --filter @helm/web run dev",
    "dev:kernel": "pnpm --filter @helm/protocol run build && tsx packages/kernel/src/main.ts",
    "dev:web": "pnpm --filter @helm/web dev",
    "helm": "tsx packages/cli/src/index.ts",
    "helm-hub": "tsx packages/kernel/src/main.ts",
    "helm-node": "tsx packages/node/src/cli.ts"
  },
  "devDependencies": {
    "@helm/cli": "workspace:*",
    "@helm/node": "workspace:*",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
