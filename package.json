{
  "name": "helm",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": { "node": ">=24.12.0" },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm build && tsc --noEmit -p tsconfig.check.json",
    "test": "timeout 180s tsx --test packages/*/test/*.test.ts",
    "dev": "pnpm dev:kernel",
    "dev:kernel": "tsx packages/kernel/src/main.ts",
    "helm": "tsx packages/node/src/cli/index.ts"
  },
  "devDependencies": {
    "@helm/node": "workspace:*",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
