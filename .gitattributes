# Sources default to LF: prevents Windows checkout (autocrlf) from checking sources out as CRLF,
# which would break tests that read sources for regex assertions (e.g. composer-layout.test.ts) and diff consistency.
* text=auto eol=lf

# Windows-only scripts stay CRLF (the cmd interpreter handles LF scripts poorly)
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files get no line-ending conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.zip binary
*.wasm binary
