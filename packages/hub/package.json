{
  "name": "@helm/hub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "helm-hub": "./dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "cd ../.. && node scripts/run-hub.mjs",
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test"
  },
  "dependencies": {
    "@helm/kernel": "workspace:*",
    "@helm/plugin-build": "workspace:*",
    "@helm/plugins": "workspace:*",
    "@helm/protocol": "workspace:*"
  },
  "devDependencies": {
    "@earendil-works/chord": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-durable": "1.5.2",
    "@helm/node": "workspace:*",
    "@helm/test-kit": "workspace:*",
    "@types/ws": "^8.18.0",
    "birpc": "^2.9.0",
    "ws": "^8.18.0"
  }
}
