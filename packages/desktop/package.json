{
  "name": "@helm/desktop",
  "private": true,
  "version": "0.1.0",
  "author": "Helm Authors",
  "license": "MIT",
  "repository": "https://github.com/team4u/helm.git",
  "type": "module",
  "description": "Helm cross-platform Electron desktop shell: attach-or-spawn supervisor for the 127.0.0.1 Hub + BrowserWindow/tray. Never imports kernel/web directly; the Hub always runs as a child process.",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test \"test/*.test.ts\"",
    "smoke": "tsx src/smoke.ts",
    "start": "tsx src/main.ts",
    "assemble:hub": "node scripts/assemble-hub.mjs",
    "dist": "pnpm run assemble:hub && electron-builder --publish never",
    "dist:dir": "pnpm run assemble:hub && electron-builder --dir --publish never"
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "npm": "^11.6.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
