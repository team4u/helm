{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "paths": {
      "@helm/protocol": ["../protocol/src/index.ts"],
      "@helm/plugin-client": [
        "../web/src/lib/plugin-client-sdk.ts"
      ],
      "lucide-react": [
        "../web/node_modules/lucide-react/dist/lucide-react.d.ts"
      ]
    },
    "baseUrl": ".",
    "typeRoots": [
      "../web/node_modules/@types"
    ]
  },
  "include": [
    "src/builtin-plugins/*/client/**/*.ts",
    "src/builtin-plugins/*/client/**/*.tsx"
  ]
}
