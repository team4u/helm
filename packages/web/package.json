{
  "name": "@helm/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 3201 --strictPort",
    "build": "pnpm typecheck && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p ../kernel/tsconfig.client.json",
    "test": "tsx --tsconfig tsconfig.test.json --test \"test/*.test.ts\""
  },
  "dependencies": {
    "@helm/protocol": "workspace:*",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.66.0",
    "mermaid": "^12.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "happy-dom": "^21.0.4",
    "typescript": "^5.9.0",
    "vite": "^6.2.0"
  }
}
