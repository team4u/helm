{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": [
    "packages/protocol/src/**/*.ts",
    "packages/kernel/src/**/*.ts",
    "packages/kernel/test/**/*.ts",
    "packages/node/src/**/*.ts",
    "packages/node/test/**/*.ts",
    "packages/cli/src/**/*.ts",
    "packages/cli/test/**/*.ts",
    "packages/web/test/**/*.ts",
    "packages/web/test/**/*.tsx"
  ],
  "exclude": [
