{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@helm/kernel": [
        "packages/kernel/src/index.ts"
      ],
      "@helm/plugins": [
        "packages/plugins/src/index.ts"
      ],
      "@helm/plugins/*": [
        "packages/plugins/src/*"
      ],
      "@helm/plugin-build": [
        "packages/plugin-build/src/index.ts"
      ]
    }
  },
  "include": [
    "packages/protocol/src/**/*.ts",
    "packages/env-io/src/**/*.ts",
    "packages/env-io/test/**/*.ts",
    "packages/plugin-client/src/**/*.ts",
    "packages/plugin-client/src/**/*.tsx",
    "packages/plugin-client/test/**/*.ts",
    "packages/plugin-client/test/**/*.tsx",
    "packages/plugin-build/src/**/*.ts",
    "packages/plugin-build/test/**/*.ts",
    "packages/kernel/src/**/*.ts",
    "packages/kernel/test/**/*.ts",
    "packages/plugins/src/**/*.ts",
    "packages/plugins/test/**/*.ts",
    "packages/hub/src/**/*.ts",
    "packages/hub/test/**/*.ts",
    "packages/node/src/**/*.ts",
    "packages/node/test/**/*.ts",
    "packages/cli/src/**/*.ts",
    "packages/cli/test/**/*.ts",
    "packages/payload/test/**/*.ts",
    "packages/desktop/src/**/*.ts",
    "packages/desktop/test/**/*.ts",
    "packages/web/test/**/*.ts",
    "packages/web/test/**/*.tsx"
  ],
  "exclude": [
    "packages/plugins/src/*/client"
  ]
}
