{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@helm/plugin-client": ["packages/web/src/lib/plugin-client-sdk.ts"]
    }
  },
  "include": [
    "packages/protocol/src/**/*.ts",
    "packages/kernel/src/**/*.ts",
    "packages/kernel/test/**/*.ts",
    "packages/node/src/**/*.ts",
    "packages/node/test/**/*.ts",
    "packages/cli/src/**/*.ts",
    "packages/cli/test/**/*.ts",
    "packages/payload/test/**/*.ts",
    "packages/desktop/src/**/*.ts",
    "packages/desktop/test/**/*.ts",
    "packages/web/test/**/*.ts",
    "packages/web/test/**/*.tsx"
  ],
  "exclude": [
    "packages/kernel/src/builtin-plugins/*/client"
  ]
}
